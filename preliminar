def resumen(tabla, campos, mes, bancos, años, estadisticas_ER, estadisticas_BG, estadisticas_IF, TC):

    fecha_compuesta_1 = str(mes[:3]) + '-' + str(años)
    fecha_compuesta_2 = str(mes[:3]) + '-' + str(años - 1)

    fecha_compuesta_PM_1 = fecha_compuesta_1 + 'Partc. Mercado'
    fecha_compuesta_PM_2 = fecha_compuesta_2 + 'Partc. Mercado'

    diccionario_1 = {'Institución': [banco for banco in bancos],
                                    fecha_compuesta_1: [], 
                                    fecha_compuesta_2: [],
                                    'Variación%': [],
                                    'Variación_USD': [],
                                    fecha_compuesta_PM_1: [], 
                                    fecha_compuesta_PM_2: []}
    
    diccionario_2 = {'Institución': [banco for banco in bancos], fecha_compuesta_1: [], fecha_compuesta_2: []}

    tabla_ER = transformar_pasar_base_ER(tabla, campos)
    tabla_BG = transformar_pasar_base_BG(tabla, campos)

    tablas_cruzadas_ER = {f'{banco}_ER': Bancos(tabla_ER, banco, años - 1, años, Variable_ER, True, TC)[0] for banco in bancos}
    tablas_cruzadas_BG = {f'{banco}_BG': Bancos(tabla_BG, banco, años - 1, años, Variable_BG, False, TC)[0] for banco in bancos}

    estadisticas_ER = {f'{banco}_ER': Bancos(tabla_ER, banco, años - 1, años, Variable_ER, True, TC)[1] for banco in bancos}
    estadisticas_BG = {f'{banco}_BG': Bancos(tabla_ER, banco, años - 1, años, Variable_ER, True, TC)[1] for banco in bancos}

    tablas_cruzadas = {}

    estadisticas = estadisticas_ER | estadisticas_BG

    for banco_ER, banco_BG in zip(tablas_cruzadas_ER.keys(), tablas_cruzadas_BG.keys()):
        df = pd.concat([banco_ER, banco_BG])
        tablas_cruzadas[str(banco_ER.split('_')[0])] = df
    
    def comparacion_año_anterior(tablas_cruzadas: dict, estadisticas, TC: int):
        lista = ['Activo ()', 'Cartera de Créditos, Neta (Activo)', 'PATRIMONIO ()', 'Depositos Totales', 'Depositos Core', 'Utilidad', 'INVERSIONES']
        banco_compuesto = [f'{banco}_ER' for banco in bancos] + [f'{banco}_BG' for banco in bancos]

        for campo in lista:
            for banco in banco_compuesto:
                if campo in ['Activos ()', 'Cartera de Créditos, Neta (Activo)', 'PATRIMONIO ()']:
                    data = tablas_cruzadas[banco]
                    valor_1 = data.loc[campo, (fecha_compuesta_1, banco)]/1000
                    valor_2 = data.loc[campo, (fecha_compuesta_2, banco)]/1000
                    diccionario_1[fecha_compuesta_1].append(valor_1)
                    diccionario_1[fecha_compuesta_2].append(valor_2)
                    diccionario_1['Variación%'].append((valor_2 - valor_1)/valor_1)
                    diccionario_1['Variación_USD'].append(valor_2 - valor_1)

                    diccionario_2[fecha_compuesta_1].append(data.loc[campo, (fecha_compuesta_1, banco)]/1000)
                    diccionario_2[fecha_compuesta_2].append(data.loc[campo, (fecha_compuesta_2, banco)]/1000)

                else:
                    valor_1 = estadisticas[fecha_compuesta_1][campo]/1000
                    valor_2 = estadisticas[fecha_compuesta_2][campo]/1000

                    diccionario_1[fecha_compuesta_1].append(valor_1)
                    diccionario_1[fecha_compuesta_2].append(valor_2)            
                    diccionario_1['Variación%'].append((valor_2 - valor_1)/valor_1)
                    diccionario_1['Variación_USD'].append(valor_2 - valor_1)

                    diccionario_2[fecha_compuesta_1].append(valor_1)
                    diccionario_2[fecha_compuesta_2].append(valor_2)
                    
            diccionario_1[fecha_compuesta_PM_1].extend([x/sum(diccionario_1[fecha_compuesta_1]) for x in diccionario_1[fecha_compuesta_1]])
            diccionario_1[fecha_compuesta_PM_2].append([x/sum(diccionario_1[fecha_compuesta_2]) for x in diccionario_1[fecha_compuesta_2]])

            df_1, df_2 = pd.DataFrame(diccionario_1), pd.DataFrame(diccionario_2)

            return df_1, df_2

    def Margen_Financiero(tablas_cruzadas, estadisticas):
        campos = ['Ingresos Financieros por Inversiones', 'Ingresos Financieros por Cartera de Créditos', 'Ingresos Financieros', 'Ajustes Mantenimiento de Valor', 'Ajustes netos por Diferencial Cambiario' , 'Gastos Financieros por Obligaciones con el Público', 'Oblig. Bancarias', 'Otros', 'Int. Recibidos', 'Int. Pagados', 'Margen Financiero']

        fechas_columnas = flatten([[fecha_compuesta_1, fecha_compuesta_2] for _ in range(len(bancos))])
        bancos_columnas = flatten([[banco, banco] for banco in bancos])

        diccionario = {campo: {(fecha, banco):[] for fecha, banco in zip(fechas_columnas, bancos_columnas)} for campo in campos}
        claves = diccionario[campos[0]].keys()

        dfs = []

        for campo in campos:
            
            for fecha, banco in claves:

                if campo == 'Int. Recibidos':
                    diccionario['Int. Recibidos'].append(diccionario['Ingresos Financieros por Inversiones'][(fecha, banco)] + diccionario['Ingresos Financieros por Cartera de Créditos'][(fecha, banco)] + diccionario['Otros'][(fecha, banco)])
                    
                elif campo == 'Margen financiero':
                    diccionario['Margen financiero'][(fecha, banco)].append(diccionario['Int. Recibidos'][(fecha, banco)] - diccionario['Int. Pagados'][(fecha, banco)])

                elif campo == 'Oblig. Bancarias': 
                    diccionario['Oblig. Bancarias'].append(diccionario['Gastos Financieros'][(fecha, banco)] - diccionario['Gastos Financieros por Obligaciones con el Público'][(fecha, banco)])

                elif campo == 'Int. Pagados':
                    diccionario['Int. Pagados'][(fecha, banco)].append(diccionario['Depósitos'][(fecha, banco)] + diccionario['Oblig. Bancarias'][(fecha, banco)])

                elif campo == 'Otros':
                    diccionario['Otros'][(fecha, banco)].append(diccionario['Ingresos Financieros'][(fecha, banco)] + diccionario['Ajustes Mantenimiento de Valor'][(fecha, banco)] + diccionario['Ajustes netos por Diferencial Cambiario'][(fecha, banco)] - diccionario['Ingresos Financieros por Inversiones'][(fecha, banco)] - diccionario['Ingresos Financieros por Cartera de Créditos'][(fecha, banco)])

                else:
                    data = tablas_cruzadas[banco] 
                    valor = data.loc[campo, (fecha, banco)]
                    diccionario[campo][(fecha, banco)].append(valor)

        df = pd.DataFrame.from_dict(diccionario, orient="index")

        return df
    
    def Utilidad_acumulada(tablas_cruzadas, estadisticas):

        campos = ['Margen Financiero', 'Resultados por Deterioro de Activos Financieros', 'Gastos de Administración', 'Contribuciones por Leyes Especiales', 'Gasto por Impuesto sobre la Renta', 'Ingresos (Gastos) Operativos, neto', 
                'Ganancia por Valoración y Venta de Activos y Otros Ingresos', 'Pérdida por Valoración y Venta de Activos', 'Resultados por Participación en Asociadas, Negocios Conjuntos y Subsidiarias', 
                'Resultados por Deterioro de Activos no Financieros', 'Otros Ingresos', 'Margen Amplio', 'Util. Antes impuestos', 'Impuesto', 'Utilidad']

        fechas_columnas = flatten([[fecha_compuesta_1, fecha_compuesta_2] for _ in range(len(bancos))])
        bancos_columnas = flatten([[banco, banco] for banco in bancos])
        
        diccionario = {campo: {(fecha, banco):[] for fecha, banco in zip(fechas_columnas, bancos_columnas)} for campo in campos}
        claves = diccionario[campos[0]].keys()

        for campo in campos:
            for fecha, banco in claves:
                if campo == 'Otros Ingresos':
                    diccionario[campo][(fecha, banco)].append(
                        diccionario['Ingresos (Gastos) Operativos, neto'][(fecha, banco)][-1] + 
                        diccionario['Ganancia por Valoración y Venta de Activos y Otros Ingresos'][(fecha, banco)][-1] + 
                        diccionario['Pérdida por Valoración y Venta de Activos'][(fecha, banco)][-1] + 
                        diccionario['Resultados por Participación en Asociadas, Negocios Conjuntos y Subsidiarias'][(fecha, banco)][-1] + 
                        diccionario['Resultados por Deterioro de Activos no Financieros'][(fecha, banco)][-1]
                    )
                elif campo == 'Margen financiero':
                    valor = estadisticas[f'{banco}_ER'][fecha]['Margen financiero U$ M'] * TC
                    diccionario[campo][(fecha, banco)].append(valor)
                elif campo == 'Margen Amplio':
                    diccionario[campo][(fecha, banco)].append(diccionario['Margen financiero'][(fecha, banco)][-1] + diccionario['Resultados por Deterioro de Activos Financieros'][(fecha, banco)][-1] + diccionario['Otros Ingresos'][(fecha, banco)][-1])
                elif campo == 'Util. Antes impuestos':
                    diccionario[campo][(fecha, banco)].append(diccionario['Margen Amplio'][(fecha, banco)][-1] + diccionario['Gastos de Administración'][(fecha, banco)][-1])
                elif campo == 'Impuesto':
                    diccionario[campo][(fecha, banco)].append(diccionario['Contribuciones por Leyes Especiales'][(fecha, banco)][-1] + diccionario['Gasto por Impuesto sobre la Renta'][(fecha, banco)][-1])
                elif campo == 'Utilidad':
                    diccionario[campo][(fecha, banco)].append(diccionario['Util. Antes impuestos'][(fecha, banco)][-1] - diccionario['Impuesto'][(fecha, banco)[-1]])

                else:
                    data = tablas_cruzadas[f'{banco}_ER']
                    diccionario[campo][(fecha, banco)].append(data.loc[campo, (fecha, banco)])

        df = pd.DataFrame.from_dict(diccionario, orient="index")
        return df
    
