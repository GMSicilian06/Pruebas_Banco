def Bancos(tabla: DataFrame, banco: str, año_1, año_2, campos: list, meses: list, ER: bool, TC: float):
    """La la tabla proviene de transformr_pasar_ER_ BG, transformar_pasar_base_BG(tabla, campos)"""
    
    años = [number for number in range(año_1, año_2 + 1)]
    rangos = flatten([[str(mes[:3]) + '-' + str(año) for mes in meses] for año in años])

    campos_1 = flatten([[campo] * len(rangos) for campo in campos])
    fechas_1 = [rango for rango in rangos] * len(campos)
    bancos = [banco] * len(campos_1)

    diccionario = {campo: {rango:[] for rango in rangos} for campo in campos}

    for _, row in tabla.iterrows():
        año, bank, valor, campo, mes = row['Año'], row['Banco'], row['Valor'], row['Campo'], row['MES']
        if año in años and str(bank) == str(banco):
            fecha_compuesta = str(mes[:3]) + '-' + str(año)
            diccionario[campo][fecha_compuesta].append(valor)
        else:
            print(f"  NO HAY MATCH: {año} in {años}? {año in años}, {bank}=={banco}? {str(bank) == str(banco)}")

    valores = []

    for campo, fecha in zip(campos_1, fechas_1):
            try:
                valor_correspondiente = diccionario[campo][fecha][0]
                valores.append(valor_correspondiente)
            except Exception as e:
                valores.append(0)

    data = {'campos': campos_1, 'Fecha': fechas_1, 'Bancos': bancos, 'values': valores}
    df = pd.DataFrame(data)
    pivot_df = df.pivot_table(
        index=["campos"],  
        columns=["Fecha", "Bancos"],  
        values="values", 
        aggfunc="sum", 
                            )
    def sort_key(col):
        fecha, bancos = col
        mes_str, año_str = fecha.split('-')
        mes_num = {m[:3]: i for i, m in enumerate(meses)}[mes_str]
        return (bancos, int(año_str), mes_num)
    
    sorted_cols = sorted(pivot_df.columns, key=sort_key)
    pivot_df = pivot_df[sorted_cols]

        # Definir cálculos y estructura según el flag ER
    if ER:
        calculos = [
            'Ingresos totales', 'Gastos', 'Costo de crédito', 'Impuesto', 'Utilidad',
            'Validación Utilidad', 'Eficiencia', 'Utilidad acumulada (U$ M)',
            'Margen financiero U$ M', 'INGRESOS FINANCIEROS', 'GASTOS FINANCIEROS', 'INGRESOS POR FX'
        ]
    else:
        calculos = [
            'CARTERA', 'DEPOSITOS', 'OTRAS OBLIGACIONES', 'TOTAL OBLIGACIONES', 'INVERSIONES',
            'INTERESES', 'PRINCIPAL + INTERESES', 'CARTERA + INTERESES PROMEDIO', 'CARTERA PROMEDIO',
            'INVERSIONES PROMEDIO', 'OBLIGACIONES PROMEDIO', 'Depositos totales', 'Depósitos Core',
            'Inversiones 1', 'ROA', 'ROE', 'Depósitos Promedios', 'Obligaciones Promedios',
            'CRECIMIENTO DEPOSITOS', 'CARTERA / DEPOSITOS', 'Loan to Deposit', 'Loans+Bonds/Deposits',
            'Fecha', 'Dia', 'Dias Acumulados', 'UTILIDAD NETA MENSUAL', 'ACTIVOS PROMEDIO', 'PATRIMONIO PROMEDIO'
        ]

    # Inicialización correcta como diccionario de listas
    estadisticas = {fecha: {calculo: [] for calculo in calculos} for fecha in rangos}

    if ER:
        for fecha in rangos:
            # Ingresos totales (Corregida la minúscula)
            estadisticas[fecha]['Ingresos totales'].append(
                pivot_df.loc['Margen Financiero, bruto', (fecha, banco)] 
                + pivot_df.loc['Ingresos (Gastos) Operativos, neto', (fecha, banco)]
                + pivot_df.loc['Resultados por Participación en Asociadas, Negocios Conjuntos y Subsidiarias', (fecha, banco)]
                + pivot_df.loc['Ganancia por Valoración y Venta de Activos y Otros Ingresos', (fecha, banco)]
                + pivot_df.loc['Ajustes netos por Diferencial Cambiario', (fecha, banco)]
                - pivot_df.loc['Resultados por Deterioro de Activos no Financieros', (fecha, banco)]
                - pivot_df.loc['Pérdida por Valoración y Venta de Activos', (fecha, banco)]
            )
            
            # Gastos
            estadisticas[fecha]['Gastos'].append(
                pivot_df.loc['Gastos de Administración', (fecha, banco)] 
                + pivot_df.loc['Contribuciones por Leyes Especiales', (fecha, banco)]
            )

            # Costo de crédito
            estadisticas[fecha]['Costo de crédito'].append(
                pivot_df.loc['Resultados por Deterioro de Activos Financieros', (fecha, banco)]
            )

            # Impuesto
            estadisticas[fecha]['Impuesto'].append(
                pivot_df.loc['Gasto por Impuesto sobre la Renta', (fecha, banco)]
            )

            # Utilidad
            utilidad_calculada = (
                estadisticas[fecha]['Ingresos totales'][-1] 
                - estadisticas[fecha]['Gastos'][-1] 
                - estadisticas[fecha]['Costo de crédito'][-1] 
                - estadisticas[fecha]['Impuesto'][-1]
            )
            estadisticas[fecha]['Utilidad'].append(utilidad_calculada)

            # Validación Utilidad
            estadisticas[fecha]['Validación Utilidad'].append(
                estadisticas[fecha]['Utilidad'][-1] 
                - pivot_df.loc['RESULTADO DEL EJERCICIO', (fecha, banco)]
            )

            # Eficiencia
            estadisticas[fecha]['Eficiencia'].append(
                estadisticas[fecha]['Gastos'][-1] / estadisticas[fecha]['Ingresos totales'][-1]
            )

            # Utilidad acumulada (U$ M)
            estadisticas[fecha]['Utilidad acumulada (U$ M)'].append(
                pivot_df.loc['RESULTADO DEL EJERCICIO', (fecha, banco)] / TC / 1000
            )

            # Ingresos y Gastos Financieros
            estadisticas[fecha]['INGRESOS FINANCIEROS'].append(
                pivot_df.loc['INGRESOS FINANCIEROS', (fecha, banco)]
            )
            estadisticas[fecha]['GASTOS FINANCIEROS'].append(
                pivot_df.loc['GASTOS FINANCIEROS', (fecha, banco)]
            )
            
            # Ingresos por FX
            estadisticas[fecha]['INGRESOS POR FX'].append(
                pivot_df.loc['Ajustes netos por Diferencial Cambiario', (fecha, banco)] 
                + pivot_df.loc['Ajustes netos por Mantenimiento de Valor', (fecha, banco)]
            )

            # Margen financiero U$ M
            estadisticas[fecha]['Margen financiero U$ M'].append(
                (estadisticas[fecha]['INGRESOS FINANCIEROS'][-1] 
                - estadisticas[fecha]['GASTOS FINANCIEROS'][-1] 
                + estadisticas[fecha]['INGRESOS POR FX'][-1]) / TC / 1000
            )

    else:
        for fecha in rangos:
            # CARTERA 
            estadisticas[fecha]['CARTERA'].append(
                pivot_df.loc['Vigentes (Cartera de Créditos, Neta)', (fecha, banco)] 
                + pivot_df.loc['Prorrogados (Cartera de Créditos, Neta)', (fecha, banco)] 
                + pivot_df.loc['Reestructurados (Cartera de Créditos, Neta)', (fecha, banco)] 
                + pivot_df.loc['Cobro Judicial (Cartera de Créditos, Neta)', (fecha, banco)]
            )

            # DEPOSITOS
            estadisticas[fecha]['DEPOSITOS'].append(
                pivot_df.loc['Moneda Extranjera (Efectivo y Equivalentes de Efectivo)', (fecha, banco)] 
                + pivot_df.loc['Moneda Nacional (Obligaciones con el Público)', (fecha, banco)] 
                + pivot_df.loc['Obligaciones por Depósitos de Instituciones Financieras y de Organismos Internacionales (Pasivo)', (fecha, banco)]
            )

            # OTRAS OBLIGACIONES
            estadisticas[fecha]['OTRAS OBLIGACIONES'].append(
                pivot_df.loc['Obligaciones Subordinadas y/o Convertibles en Capital (Pasivo)', (fecha, banco)] 
                + pivot_df.loc['Intereses sobre Obligaciones con el Público por Depósitos (Obligaciones con el Público)', (fecha, banco)] 
            )
            # Nota: Agrega aquí el resto de tus cálculos para el bloque else...

            
            # TOTAL OBLIGACIONES 
            estadisticas[fecha]['TOTAL OBLIGACIONES'].append(
                estadisticas[fecha]['DEPOSITOS'][-1] 
                + estadisticas[fecha]['OTRAS OBLIGACIONES'][-1]
            )

            # INVERSIONES 
            estadisticas[fecha]['INVERSIONES'].append(
                pivot_df.loc['Equivalentes de Efectivo (Moneda Nacional)', (fecha, banco)]
                + pivot_df.loc['Equivalentes de Efectivo (Moneda Extranjera)', (fecha, banco)]
                + pivot_df.loc['Inversiones a Valor Razonable con Cambios en Otro Resultado Integral (Activo)', (fecha, banco)]
                + pivot_df.loc['Inversiones a Costo Amortizado, Neto (Activo)', (fecha, banco)]
            )
            
            #INTERESES
            estadisticas[fecha]['INTERESES'].append(
                pivot_df.loc['Equivalentes de Efectivo (Moneda Nacional)', (fecha, banco)]
                + pivot_df.loc['Equivalentes de Efectivo (Moneda Extranjera)', (fecha, banco)]
                + pivot_df.loc['Inversiones a Valor Razonable con Cambios en Otro Resultado Integral (Activo)', (fecha, banco)]
                + pivot_df.loc['Inversiones a Costo Amortizado, Neto (Activo)', (fecha, banco)]
            )

            
            estadisticas[fecha]['PRINCIPAL + INTERESES'] = estadisticas[fecha]['INTERESES'][0] + estadisticas[fecha]['CARTERA'][0]

            estadisticas[fecha]['CARTERA + INTERESES PROMEDIO'].append(
                pivot_df.loc['Equivalentes de Efectivo (Moneda Nacional)', (fecha, banco)]
                + pivot_df.loc['Equivalentes de Efectivo (Moneda Extranjera)', (fecha, banco)]
                + pivot_df.loc['Inversiones a Valor Razonable con Cambios en Otro Resultado Integral (Activo)', (fecha, banco)]
