                + pivot_df.loc['Inversiones a Valor Razonable con Cambios en Otro Resultado Integral (Activo)', (fecha, banco)]
                + pivot_df.loc['Inversiones a Costo Amortizado, Neto (Activo)', (fecha, banco)]
            )

